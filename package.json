{
  "name": "gistline",
  "version": "0.4.0",
  "description": "Compress large command output, logs and documents before an AI assistant reads them - and know whether anything was removed. Zero dependencies, deterministic, with the original always retrievable.",
  "type": "module",
  "license": "MIT",
  "author": "Majid Bilal <majidbilaly@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/majidbilal/gistline.git"
  },
  "homepage": "https://github.com/majidbilal/gistline#readme",
  "bugs": {
    "url": "https://github.com/majidbilal/gistline/issues"
  },
  "main": "./index.mjs",
  "exports": {
    ".": "./index.mjs",
    "./index.mjs": "./index.mjs",
    "./store.mjs": "./store.mjs",
    "./install.mjs": "./install.mjs",
    "./lossless.mjs": "./lossless.mjs",
    "./mcp.mjs": "./mcp.mjs",
    "./core/*.mjs": "./core/*.mjs",
    "./util/*.mjs": "./util/*.mjs",
    "./transforms/*.mjs": "./transforms/*.mjs",
    "./package.json": "./package.json"
  },
  "bin": {
    "gistline": "cli.mjs",
    "gistline-mcp": "mcp.mjs"
  },
  "files": [
    "index.mjs",
    "cli.mjs",
    "mcp.mjs",
    "install.mjs",
    "store.mjs",
    "lossless.mjs",
    "core/*.mjs",
    "util/*.mjs",
    "transforms/*.mjs",
    "hooks/*.mjs",
    "!**/*.test.mjs",
    "scripts/*.mjs",
    "docs/hero.svg",
    "docs/ARCHITECTURE.md",
    "README.md",
    "LICENSE",
    "ROADMAP.md",
    "CHANGELOG.md",
    "ISSUES.md",
    "SECURITY.md",
    "CONTRIBUTING.md"
  ],
  "engines": {
    "node": ">=20.15.0"
  },
  "keywords": [
    "compression",
    "tokens",
    "context-window",
    "llm",
    "ai",
    "cli",
    "mcp",
    "logs",
    "test-output",
    "pdf",
    "docx",
    "xlsx",
    "pptx",
    "html",
    "markdown",
    "claude-code",
    "cursor",
    "codex",
    "copilot",
    "gemini-cli",
    "aider",
    "zero-dependencies",
    "deterministic"
  ],
  "scripts": {
    "test": "node --test",
    "smoke": "node scripts/smoke.mjs",
    "check-claims": "node scripts/check-claims.mjs",
    "hero": "node scripts/make-hero.mjs",
    "demo": "node scripts/demo.mjs",
    "demo-pdf": "node scripts/demo-pdf.mjs",
    "demo-xlsx": "node scripts/demo-xlsx.mjs",
    "verify-package": "npm pack && node scripts/smoke.mjs",
    "prepublishOnly": "npm test && npm run check-claims && npm run smoke",
    "architecture": "node scripts/make-architecture.mjs"
  }
}
